# Utilizamos la función summarize de dplyr y usando el conector pepe conectamos nuestros datos con la función.
click_data %>%
summarize(media = mean(clicked_adopt_today))
# usar la función mean para
# obtener promedio
# Utilizamos la función summarize de dplyr y usando el conector pepe conectamos nuestros datos con la función.
click_data %>%
summarize(conversion_rate = mean(clicked_adopt_today))
# usar la función mean para
# obtener promedio
# Carga la librería lubridate
library(lubridate)
click_data %>%
group_by(month(visit_date)) %>%
summarize(conversion_rate = mean(clicked_adopt_today))
# Calculate the mean conversion rate by week of the year
click_data %>%
group_by(week(visit_date)) %>%
summarize(conversion_rate = mean(clicked_adopt_today))
library(scales)
# repite la instrucción anterior de cálculo de ratio de conversion por semanas y almacene dicho resultado en una variable de nombre click_data_sum
click_data_sum <- click_data %>%
group_by(week(visit_date)) %>%
summarize(conversion_rate = mean(clicked_adopt_today))
# utilice la función ggplot donde el eje x son las semanas calculadas con la función weeks
# el eje y es el ratio de conversión
ggplot(click_data_sum, aes(x = `week`,
y = conversion_rate)) +
geom_point() + # Función geom_point
geom_line() + # Función geom_line para el dibujado de la gráfica
scale_y_continuous(limits = c(0, 1),
labels = percent)
