#Ejercicio 4
test <- read.csv("data/test.csv", sep = "\t", head =TRUE)
test$id <- NULL
head(test)
names(test)
pred <- predict(tree, test, type = "class")
# Construye la matriz de confusion
conf <- table (test$Survived, pred)
#Calcula el accuracy
acc <- sum(diag(conf)) / sum(conf)
print(acc)
