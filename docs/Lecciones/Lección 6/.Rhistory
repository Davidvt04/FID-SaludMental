# Carga el fichero.
# Nota: al descomprimir data.zip el fichero queda en "data/data/toy_example.txt";
# se comprueba qué ruta existe para que el cuaderno funcione en ambos casos.
ruta <- if (file.exists("data/toy_example.txt")) "data/toy_example.txt" else "data/data/toy_example.txt"
puntos <- read.delim(ruta,
sep = "\t",
head = FALSE)
# Visualiza su disposición en el plano
plot(puntos) # Los representamos geométricamente
# Función head:
head(puntos)
# Función str
str(puntos)
# Función dim
dim(puntos)
# Aplicamos el algoritmo k-means con tres centros de masa y el parámetro nstart igual a 20
set.seed(1234)  # para que los resultados sean reproducibles
km.out <- kmeans(puntos, centers = 3, nstart = 20)
summary(km.out)
# Aplicamos el algoritmo k-means con tres centros de masa y el parámetro nstart igual a 20
set.seed(1234)  # para que los resultados sean reproducibles
km_puntos <- kmeans(puntos, centers = 3, nstart = 20)
summary(km_puntos)
km_puntos$cluster
km_puntos
plot(puntos,
col = km_puntos$cluster,
main = "k-means con k = 3",
xlab = "", ylab = "")
points(km_puntos$centers, col = 1:3, pch = 8, cex = 2, lwd = 2)  # centroides
par(mfrow = c(2, 3))   # 6 gráficos en una rejilla de 2 x 3
set.seed(1)
for (i in 1:6) {
km.out1 <- kmeans(puntos, centers = 3, nstart = 1)
plot(puntos,
col = km.out1$cluster,
main = paste("nstart=1 | tot.withinss =", round(km.out1$tot.withinss, 1)),
xlab = "", ylab = "", cex.main = 0.8)
}
par(mfrow = c(1, 1))
par(mfrow = c(2, 3))
set.seed(1)
for (i in 1:6) {
km.out20 <- kmeans(puntos, centers = 3, nstart = 20)
plot(puntos,
col = km.out20$cluster,
main = paste("nstart=20 | tot.withinss =", round(km.out20$tot.withinss, 1)),
xlab = "", ylab = "", cex.main = 0.8)
}
par(mfrow = c(1, 1))
wss <- numeric(15)   # vector para guardar tot.withinss
set.seed(1234)
for (k in 1:15) {
km.k <- kmeans(puntos, centers = k, nstart = 20)
wss[k] <- km.k$tot.withinss
}
plot(1:15, wss, type = "b", pch = 19,
xlab = "Número de clústeres (k)",
ylab = "Suma de cuadrados intraclúster (tot.withinss)",
main = "Método del codo")
# Al descomprimir data.zip el fichero queda en "data/data/"; se admiten ambas rutas.
ruta <- if (file.exists("data/WisconsinCancer.csv")) "data/WisconsinCancer.csv" else "data/data/WisconsinCancer.csv"
wisc.df <- read.csv(ruta)
str(wisc.df)
# Al descomprimir data.zip el fichero queda en "data/data/"; se admiten ambas rutas.
ruta <- if (file.exists("data/WisconsinCancer.csv")) "data/WisconsinCancer.csv" else "data/data/WisconsinCancer.csv"
wisc.df <- read.csv(ruta)
str(wisc.df)
head(wisc.df)
dim(wisc.df)          # 569 filas y 33 columnas
names(wisc.df)
table(wisc.df$diagnosis)
summary(wisc.df$X)    # la última columna es completamente NA
wisc.data <- as.matrix(wisc.df[, 3:32])   # 30 variables numéricas
row.names(wisc.data) <- wisc.df$id
dim(wisc.data)
head(wisc.data[, 1:6])
round(colMeans(wisc.data), 3)
round(apply(wisc.data, 2, sd), 3)
wisc.data.scaled <- scale(wisc.data)
# Comprobación: medias ~ 0 y desviaciones típicas = 1
round(colMeans(wisc.data.scaled), 3)
apply(wisc.data.scaled, 2, sd)
# Los datos ya están escalados; aun así, indicar scale = TRUE no altera el resultado.
wisc.pr <- prcomp(wisc.data.scaled, center = TRUE, scale = TRUE)
set.seed(1234)
wss <- numeric(15)
for (k in 1:15) {
wss[k] <- kmeans(wisc.pr7, centers = k, nstart = 20, iter.max = 50)$tot.withinss
}
